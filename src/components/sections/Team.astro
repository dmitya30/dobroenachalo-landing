---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import ExpandableBlock from '../ui/ExpandableBlock.astro';

// Glob по обоим форматам — маппинг строго по имени файла из JSON (entry.data.photo).
// Записи без photo рендерятся плейсхолдером с инициалами.
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/team/*.{jpg,webp}',
  { eager: true }
);
const photoMap: Record<string, ImageMetadata> = {};
for (const path in photoModules) {
  const filename = path.split('/').pop()!;
  photoMap[filename] = photoModules[path].default;
}

// Групповое фото команды
const groupPhoto = photoMap['team-all.webp'] ?? null;

const all = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((m) => m.data.featured);
const rest = all.filter((m) => !m.data.featured);

/** Инициалы: первая буква первого слова + первая буква последнего слова */
function getInitials(name: string): string {
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
  return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
}
---
<section id="team" class="bg-bg-soft py-16 md:py-20 lg:py-24">
  <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Наша команда"
      lead="Наши учителя и воспитатели — люди с опытом, внутренней теплотой и любовью к детям. Они сочетают знания детской психологии с умением слышать и вести за собой."
      class="mb-8 md:mb-10"
    />

    <p class="text-center text-base md:text-lg text-text-muted max-w-3xl mx-auto mb-12 md:mb-16">
      Команда профессионалов, вдохновлённых идеей сделать образование увлекательным и осмысленным.
    </p>

    <!-- 5 ключевых карточек с цитатами: фото слева, текст справа, сетка 3×2 на десктопе (6-я ячейка пустая) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 mb-12 md:mb-16">
      {featured.map((member) => {
        const photo = member.data.photo ? photoMap[member.data.photo] : null;
        return (
          <article class="bg-bg rounded-2xl overflow-hidden shadow-sm flex flex-col sm:flex-row lg:flex-col xl:flex-row">
            <div class="sm:w-2/5 lg:w-full xl:w-2/5 shrink-0 bg-bg-soft aspect-[4/5] sm:aspect-auto lg:aspect-[4/5] xl:aspect-auto">
              {photo ? (
                <Image
                  src={photo}
                  alt={member.data.name}
                  widths={[400, 600, 800]}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 280px, (max-width: 1280px) 33vw, 220px"
                  class="w-full h-full object-cover object-top"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-indigo text-bg text-5xl font-semibold">
                  {getInitials(member.data.name)}
                </div>
              )}
            </div>
            <div class="p-6 md:p-7 flex flex-col gap-2">
              <h3 class="text-lg md:text-xl font-semibold text-indigo leading-snug">{member.data.name}</h3>
              <p class="text-sm font-medium text-cta">{member.data.role}</p>
              {member.data.quote && (
                <blockquote class="relative mt-3 pl-4 border-l-2 border-cta/40">
                  <p class="text-sm md:text-base text-text-muted leading-relaxed italic">{member.data.quote}</p>
                </blockquote>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <!-- Остальные в expand -->
    <ExpandableBlock summary={`Показать всю команду (${rest.length} человек)`}>
      {groupPhoto && (
        <figure class="mb-8">
          <Image
            src={groupPhoto}
            alt="Команда школы «Доброе Начало» — все педагоги и сотрудники"
            widths={[600, 900, 1200, 1600]}
            sizes="(max-width: 1024px) 100vw, 900px"
            class="w-full h-auto rounded-2xl shadow-[var(--shadow-card)] object-cover"
            loading="lazy"
          />
          <figcaption class="text-center text-sm text-text-muted mt-3 italic">
            Команда «Доброго Начала»
          </figcaption>
        </figure>
      )}
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 list-none p-0 pt-2">
        {rest.map((member) => {
          const photo = member.data.photo ? photoMap[member.data.photo] : null;
          return (
            <li class="flex flex-col items-center text-center gap-3">
              {photo ? (
                <Image
                  src={photo}
                  alt={member.data.name}
                  widths={[160, 240]}
                  sizes="80px"
                  class="w-20 h-20 rounded-full object-cover object-top"
                  loading="lazy"
                />
              ) : (
                <div class="w-20 h-20 rounded-full flex items-center justify-center bg-indigo text-bg text-xl font-semibold">
                  {getInitials(member.data.name)}
                </div>
              )}
              <div class="flex flex-col gap-1">
                <p class="text-sm font-semibold text-indigo leading-snug">{member.data.name}</p>
                <p class="text-xs text-text-muted leading-snug">{member.data.role}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </ExpandableBlock>
  </div>
</section>
