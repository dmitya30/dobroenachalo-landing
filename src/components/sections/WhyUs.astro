---
import { Icon } from 'astro-icon/components';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

interface Tile {
  icon: string;
  title: string;
  text: string;
}

const tiles: Tile[] = [
  {
    icon: 'lucide:eye',
    title: 'Каждый ребёнок — в фокусе внимания',
    text: 'Педагог видит каждого: замечает настроение, мягко помогает преодолеть трудность. Ребёнок растёт не в толпе, а в кругу, где его знают и ценят.',
  },
  {
    icon: 'lucide:infinity',
    title: 'Единый путь без разрывов и стрессов',
    text: 'Ребёнок проходит путь от первых игр к первым открытиям в знакомом пространстве — без стресса «новой школы». Те же педагоги, ритмы и ценности сопровождают его все годы.',
  },
  {
    icon: 'lucide:heart-handshake',
    title: 'Педагоги, которые видят за поступком — человека',
    text: 'Наши учителя и воспитатели — с опытом и внутренней теплотой. Они сочетают знания детской психологии с умением слышать и вести за собой.',
  },
  {
    icon: 'lucide:salad',
    title: 'Питание как вклад в здоровье',
    text: 'Меню разработано детским нутрициологом с учётом возрастных потребностей детей. Блюда готовятся ежедневно из свежих продуктов.',
  },
  {
    icon: 'lucide:home',
    title: 'Семья — особая ценность',
    text: 'Праздники, спортивные дни, уютные вечера — искренние моменты, где взрослые и дети становятся ближе.',
  },
  {
    icon: 'lucide:sprout',
    title: 'Крепкие корни, современные крылья',
    text: 'Мы опираемся на проверенные временем основы — Выготского, советскую педагогику, систему развивающего обучения. Адаптируем лучшее под сегодня: под интересы ребёнка, его ритм и реальность.',
  },
];
---

<section id="why-us" class="bg-bg-warm py-16 md:py-20 lg:py-24">
  <div class="container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="Почему выбирают «Доброе Начало»"
      class="mb-12 md:mb-16"
    />

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 list-none p-0">
      {tiles.map((tile) => (
        <Card as="li" variant="soft" class="flex flex-col gap-4">
          <div class="flex items-center justify-center w-14 h-14 rounded-xl bg-bg text-cta shrink-0">
            <Icon name={tile.icon} class="w-8 h-8" aria-hidden="true" />
          </div>
          <h3 class="text-xl font-semibold text-indigo leading-snug">
            {tile.title}
          </h3>
          <p class="text-base text-text-muted leading-relaxed">
            {tile.text}
          </p>
        </Card>
      ))}
    </ul>
  </div>
</section>
