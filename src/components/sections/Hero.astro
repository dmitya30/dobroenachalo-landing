---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import RatingBadge from '../ui/RatingBadge.astro';
import { site } from '../../data/site';
import heroImage from '../../assets/hero/hero-01-08-05-375.jpg';
import telegramSvg from '../../icons/telegram.svg?raw';
import maxSvg from '../../icons/max.svg?raw';

// Чипы под H1 (рейтинг рендерится отдельно через RatingBadge)
const chips = [
  { icon: 'lucide:users', label: 'Классы до 10 детей' },
  { icon: 'lucide:trees', label: 'Сосновый бор, закрытая территория' },
  { icon: 'lucide:train-front', label: site.address.nearestStation },
];
---

<section class="relative min-h-[600px] lg:min-h-[640px] flex items-center overflow-hidden">
  <Image
    src={heroImage}
    alt="Дети школы-сада «Доброе Начало» на прогулке в сосновом лесу"
    class="absolute inset-0 w-full h-full object-cover"
    loading="eager"
    fetchpriority="high"
    quality={75}
    widths={[640, 960, 1280]}
    sizes="100vw"
  />

  {/* Градиент: на мобиле вертикальный (текст внизу читаем), на десктопе — слева направо */}
  <div class="absolute inset-0 bg-gradient-to-b from-indigo/40 via-indigo/70 to-indigo/90 md:bg-gradient-to-r md:from-indigo/85 md:via-indigo/60 md:to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 w-full">
    <div class="max-w-2xl text-text-inverse">
      <p class="text-sm uppercase tracking-wider mb-4 opacity-90 font-sans">
        {site.tagline}
      </p>

      <h1 class="text-hero mb-6">
        Частная школа-сад в сосновом лесу под Москвой
      </h1>

      <p class="text-lg md:text-xl mb-8 opacity-95 font-sans">
        От {site.ageRange.from.toString().replace('.', ',')} лет до уверенного старта в 5 классе. Единый путь сад → школа → лагерь.
      </p>

      <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-8">
        <RatingBadge size="sm" variant="on-dark" />
        {chips.map((chip) => (
          <span class="inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm rounded-full px-3 py-1.5 text-sm">
            <Icon name={chip.icon} class="w-4 h-4" aria-hidden="true" />
            <span>{chip.label}</span>
          </span>
        ))}
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <Button href={site.phone.href} variant="primary" size="lg">
          Записаться на пробный день
        </Button>

        <div class="flex flex-wrap items-center gap-3 text-base">
          <a href={site.phone.href} class="font-semibold hover:text-cta transition-colors">
            {site.phone.display}
          </a>
          <span aria-hidden="true" class="opacity-50">|</span>
          <span class="opacity-90">Написать в</span>
          <a
            href={site.social.telegram.contact}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center hover:opacity-80 transition-opacity"
            aria-label="Написать в Telegram"
          >
            <span class="w-6 h-6 inline-block" set:html={telegramSvg} />
          </a>
          <a
            href={site.social.max.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center hover:opacity-80 transition-opacity"
            aria-label="Написать в Макс"
          >
            <span class="w-6 h-6 inline-block" set:html={maxSvg} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
