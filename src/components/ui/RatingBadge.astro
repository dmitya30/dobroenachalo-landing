---
import { site } from '../../data/site';

interface Props {
  /** Куда ведёт клик. По умолчанию — внешняя ссылка на отзывы */
  href?: string;
  /** Размер */
  size?: 'sm' | 'md' | 'lg';
  /**
   * Вариант для контекста:
   * - default — голубая подложка + индиго-текст (для светлых фонов)
   * - on-dark — белая полупрозрачная подложка + белый текст (для тёмных фонов: Hero, Footer)
   */
  variant?: 'default' | 'on-dark';
  class?: string;
}

const {
  href = site.rating.sourceUrl,
  size = 'md',
  variant = 'default',
  class: className = '',
} = Astro.props;

const sizes = {
  sm: 'text-sm px-3 py-1.5 gap-1.5',
  md: 'text-base px-4 py-2 gap-2',
  lg: 'text-lg px-5 py-2.5 gap-2',
};

const variants = {
  default: 'bg-bg-soft text-indigo hover:bg-cream',
  'on-dark': 'bg-white/15 text-text-inverse backdrop-blur-sm hover:bg-white/25',
};

const sourceMuted = {
  default: 'text-text-muted',
  'on-dark': 'text-text-inverse/75',
};

// Форматирование рейтинга: 4.7 -> "4,7" для RU
const ratingDisplay = site.rating.value.toString().replace('.', ',');
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`inline-flex items-center rounded-full font-semibold transition-colors ${variants[variant]} ${sizes[size]} ${className}`}
  aria-label={`Рейтинг ${ratingDisplay} из ${site.rating.bestRating} на ${site.rating.source}, ${site.rating.count} отзывов`}
>
  <svg
    class="w-4 h-4 text-cta"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
  </svg>
  <span>{ratingDisplay}</span>
  <span class={`${sourceMuted[variant]} text-sm`}>·</span>
  <span class="text-sm">{site.rating.source}</span>
</a>
