---
import { site } from '../../data/site';
import telegramSvg from '../../icons/telegram.svg?raw';
import maxSvg from '../../icons/max.svg?raw';
import vkSvg from '../../icons/vk.svg?raw';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  variant?: 'light' | 'dark';
  /**
   * channels - публичные ресурсы (TG-канал, Макс, VK) для футера.
   * contacts - личные контакты для связи (TG-менеджер, Макс) для хедера/hero.
   */
  mode?: 'channels' | 'contacts';
  class?: string;
}

const {
  size = 'md',
  variant = 'dark',
  mode = 'channels',
  class: className = '',
} = Astro.props;

const sizeClasses = {
  sm: 'w-5 h-5',
  md: 'w-6 h-6',
  lg: 'w-8 h-8',
};

const variantClasses = {
  dark: 'text-indigo hover:opacity-80',
  light: 'text-text-inverse hover:opacity-80',
};

const linkBase = `inline-flex items-center justify-center transition-opacity ${variantClasses[variant]}`;
const iconClass = sizeClasses[size];

const channels = [
  { href: site.social.telegram.channel, label: 'Telegram-канал', svg: telegramSvg },
  { href: site.social.max.url, label: 'Макс', svg: maxSvg },
  { href: site.social.vk.url, label: 'VK', svg: vkSvg },
];

const contacts = [
  { href: site.social.telegram.contact, label: 'Написать в Telegram', svg: telegramSvg },
  { href: site.social.max.url, label: 'Написать в Макс', svg: maxSvg },
];

const items = mode === 'contacts' ? contacts : channels;
---

<ul class={`flex items-center gap-3 ${className}`}>
  {items.map((item) => (
    <li>
      <a
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        class={linkBase}
        aria-label={`${item.label} (открыть в новой вкладке)`}
      >
        <span class={iconClass} set:html={item.svg} />
      </a>
    </li>
  ))}
</ul>
