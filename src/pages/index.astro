---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import OfferCards from '../components/sections/OfferCards.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import Kindergarten from '../components/sections/Kindergarten.astro';
import School from '../components/sections/School.astro';
import SummerCamp from '../components/sections/SummerCamp.astro';
import AdditionalClasses from '../components/sections/AdditionalClasses.astro';
import Team from '../components/sections/Team.astro';
import Reviews from '../components/sections/Reviews.astro';
import SchoolLife from '../components/sections/SchoolLife.astro';
import HowToEnroll from '../components/sections/HowToEnroll.astro';
import FAQ from '../components/sections/FAQ.astro';
import Contacts from '../components/sections/Contacts.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.name} - частная школа-сад в Нахабино | 2,5-11 лет`}
  description={site.description}
  noindex={false}
>
  <Header />
  <main>
    <Hero />
    <OfferCards />
    <WhyUs />
    <Philosophy />
    <Kindergarten />
    <School />
    <SummerCamp />
    <AdditionalClasses />
    <Team />
    <Reviews />
    <SchoolLife />
    <HowToEnroll />
    <FAQ />
    <Contacts />
  </main>
 <Footer />
</BaseLayout>
