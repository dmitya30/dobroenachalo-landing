---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import OfferCards from '../components/sections/OfferCards.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import Kindergarten from '../components/sections/Kindergarten.astro';
import School from '../components/sections/School.astro';
import SummerCamp from '../components/sections/SummerCamp.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout
  title={`${site.name} - частная школа-сад в Нахабино | 2,5-11 лет`}
  description={`Частная школа-сад в сосновом лесу, 380 м от МЦД «Нахабино Ясное». Классы до 10 детей, программа Выготского-Эльконина-Давыдова. Рейтинг 4,7 на Яндекс.Картах.`}
  noindex={true}
>
  <Header />
  <main>
    <Hero />
    <OfferCards />
    <WhyUs />
    <Philosophy />
    <Kindergarten />
    <School />
    <SummerCamp />
    <!-- Здесь будут Classes, Team, Reviews, SchoolLife, HowToEnroll, FAQ, Contacts -->
    <section class="py-20 text-center text-text-muted">
      <p>Остальные секции в разработке.</p>
    </section>
  </main>
  <Footer />
</BaseLayout>
