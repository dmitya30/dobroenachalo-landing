---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcons from '../components/ui/SocialIcons.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-2xl">
      <h1 class="text-hero text-indigo mb-4">{site.name}</h1>
      <p class="text-xl text-text-muted mb-8">{site.tagline}. Сайт в разработке.</p>

      <a
        href={site.phone.href}
        class="inline-block bg-cta hover:bg-cta-hover text-text-inverse font-semibold px-8 py-4 rounded-lg shadow-cta transition-colors"
      >
        {site.phone.display}
      </a>

      <div class="mt-10 flex justify-center">
        <SocialIcons size="lg" variant="dark" />
      </div>

      <p class="mt-8 text-sm text-text-muted">
        {site.address.locality}, {site.address.street} · {site.address.nearestStation}
      </p>
    </div>
  </main>
</BaseLayout>
